#!/bin/sh
# SPDX-License-Identifier: MIT
set -eu
product=${1:?usage: scripts/package-product PRODUCT OUTPUT_DIRECTORY}
out=${2:?usage: scripts/package-product PRODUCT OUTPUT_DIRECTORY}
case "$product" in qwen) ;; *) echo 'This repository packages only qwen.' >&2; exit 1;; esac
mkdir -p "$out"
out=$(CDPATH='' cd "$out" && pwd -P)
repo=$(CDPATH='' cd "$(dirname "$0")/.." && pwd -P)
cd "$repo"
. "$repo/scripts/release/version.sh"
peer_version_init "$repo"
stage=$(CDPATH='' cd "$(mktemp -d)" && pwd -P)
trap 'rm -rf "$stage"' 0
trap 'exit 1' HUP INT TERM
platform=${GOOS:-$(go env GOOS)}
arch=${GOARCH:-$(go env GOARCH)}
CGO_ENABLED=0 GOOS="$platform" GOARCH="$arch" peer_go_build "$stage/$product-peer" "./cmd/$product-peer"
mkdir "$stage/plugin"
cp -R "$product/." "$stage/plugin/"
cp scripts/release/THIRD-PARTY-NOTICES.txt LICENSE "$stage/"
printf '%s\n' "$peer_revision" > "$stage/SOURCE.txt"
cp scripts/release/install-product "$stage/install"
cp "$product/README.md" "$stage/README.md"
printf '%s\n' "$product" > "$stage/ROLE"
set -- "$product-peer"
ln -s "$product-peer" "$stage/$product-peer-mcp"
set -- "$@" "$product-peer-mcp"
tar -czf "$out/$product-peer-$platform-$arch.tar.gz" -C "$stage" "$@" plugin LICENSE THIRD-PARTY-NOTICES.txt README.md install ROLE SOURCE.txt
