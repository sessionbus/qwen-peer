#!/bin/sh
# SPDX-License-Identifier: MIT
set -eu
src=$(CDPATH='' cd "$(dirname "$0")" && pwd -P)
product=$(cat "$src/ROLE")
case "$product" in qwen) ;; *) echo 'Unknown product' >&2; exit 1;; esac
command -v "$product" >/dev/null || { echo "Install native $product first." >&2; exit 1; }
root="$HOME/.local/libexec/sessionbus/$product"
[ ! -L "$root" ] || { echo 'Indirect package root; review before replacing.' >&2; exit 1; }
mkdir -p "$root" "$HOME/.local/bin"
stage=$(mktemp -d "$root/.plugin.XXXXXX")
trap 'rm -rf "$stage"' 0
trap 'exit 1' HUP INT TERM
cp -R "$src/plugin/." "$stage/"
install -m 755 "$src/$product-peer" "$root/$product-peer.new"
mv -f "$root/$product-peer.new" "$root/$product-peer"
rm -rf "$root/plugin"
mv "$stage" "$root/plugin"
cp "$src/LICENSE" "$src/THIRD-PARTY-NOTICES.txt" "$src/README.md" "$src/SOURCE.txt" "$root/"
ln -sfn "$root/$product-peer" "$HOME/.local/bin/$product-peer"
export PATH="$HOME/.local/bin:$PATH"
case "$product" in
 qwen)
  ln -sfn qwen-peer "$root/qwen-peer-mcp"
  if [ -d "$HOME/.qwen/extensions/sessionbus" ]; then qwen extensions uninstall sessionbus; fi
  qwen extensions install "$root/plugin" --consent --scope user
  ;;
esac
printf 'Installed %s. Ensure ~/.local/bin is on your login PATH.\n' "$HOME/.local/bin/$product-peer"
